{
  "components": [
    {
      "canvas": {
        "widgets": [
          {
            "data": {
              "text": "External, independently-packaged system daemon (OpenRazer project) that owns direct USB/HID communication with Razer hardware and exposes it over D-Bus (org.razer). Both RazerGenie and Polychromatic are alternative GUI front-ends to this same daemon; its source is not part of this repository."
            },
            "h": 180,
            "id": "widget-1790334421757-0",
            "title": "Intent & Scope Description",
            "type": "text",
            "w": 350,
            "x": 30,
            "y": 30
          },
          {
            "data": {
              "techs": [
                "D-Bus (org.razer)",
                "Python daemon (external project)"
              ]
            },
            "h": 200,
            "id": "widget-1790334421777-1",
            "title": "Tech Stack Profiles",
            "type": "techstack",
            "w": 350,
            "x": 60,
            "y": 60
          },
          {
            "data": {
              "text": "The OpenRazer daemon is a separate upstream project (github.com/openrazer/openrazer) installed on the system. RazerGenie depends on it via the libopenrazer C++ library (Meson dependency with subproject fallback); Polychromatic depends on it via the \"openrazer\" Python client library. Neither daemon nor client library source lives in this workspace."
            },
            "h": 200,
            "id": "widget-1790334421793-2",
            "title": "External dependency, not in this repo",
            "type": "note",
            "w": 350,
            "x": 90,
            "y": 90
          }
        ]
      },
      "id": "openrazer-daemon",
      "name": "OpenRazer Daemon",
      "type": "custom"
    },
    {
      "canvas": {
        "widgets": [
          {
            "data": {
              "text": "PyQt6 front end (package hueberry) for OpenRazer: device pages, whole-device lighting presets, per-key advanced effects (key groups with static/wave/breathing/spectrum/reactive/ripple/starlight, rendered by a background runtime that keeps running in the tray), named advanced presets with last-used restore, macros and sysmon."
            },
            "h": 200,
            "id": "widget-text-razerui",
            "title": "Intent & Scope",
            "type": "text",
            "w": 350,
            "x": 0,
            "y": 0
          },
          {
            "data": {
              "techs": [
                "Python",
                "PyQt6"
              ]
            },
            "h": 200,
            "id": "widget-techstack-razerui",
            "title": "Tech Stack",
            "type": "techstack",
            "w": 350,
            "x": 0,
            "y": 0
          }
        ]
      },
      "id": "razerui",
      "name": "RazerUI",
      "type": "frontend"
    },
    {
      "canvas": {
        "widgets": [
          {
            "data": {
              "routes": [
                {
                  "desc": "Watch (non-grabbing) evdev nodes whose name contains any given device name; [] stops",
                  "method": "IPC",
                  "path": "key_watch"
                },
                {
                  "desc": "Key-down events since a sequence cursor from a bounded ring buffer",
                  "method": "IPC",
                  "path": "key_events"
                }
              ]
            },
            "h": 200,
            "id": "widget-endpoints-macro-engine",
            "title": "API Endpoints",
            "type": "endpoints",
            "w": 350,
            "x": 0,
            "y": 0
          }
        ]
      },
      "id": "macro-engine",
      "name": "Macro Engine",
      "type": "backend"
    },
    {
      "canvas": {
        "widgets": [
          {
            "data": {
              "text": "System monitor overlay: an external `waybar` child process (own session/process group, pid in $XDG_RUNTIME_DIR/hueberry/sysmon.pid) spawned and managed by RazerUI's SysmonController (hueberry/sysmon/controller.py). hueberry/sysmon/waybar.py writes its config under $XDG_CONFIG_HOME/hueberry/sysmon with a `custom/sysmon` module that runs `python -m hueberry.sysmon.collector --config PATH`; the collector reads /proc and /sys and prints one JSON metrics line per interval for Waybar to draw."
            },
            "h": 180,
            "id": "widget-1790745315171-0",
            "title": "Intent & Scope Description",
            "type": "text",
            "w": 350,
            "x": 30,
            "y": 30
          },
          {
            "data": {
              "techs": [
                "Waybar (external binary)",
                "Python (hueberry.sysmon.collector)",
                "Linux /proc and /sys"
              ]
            },
            "h": 200,
            "id": "widget-1790745315178-1",
            "title": "Tech Stack Profiles",
            "type": "techstack",
            "w": 350,
            "x": 60,
            "y": 60
          }
        ]
      },
      "id": "sysmon-overlay",
      "name": "Sysmon Overlay (Waybar + collector)",
      "type": "backend"
    },
    {
      "canvas": {
        "widgets": []
      },
      "id": "sysmon",
      "name": "Sysmon",
      "type": "custom"
    }
  ],
  "connections": [
    {
      "from": "razerui",
      "protocol": "D-Bus (via system openrazer.client Python library); lifecycle control via subprocess (systemctl --user is-active/restart openrazer-daemon, else openrazer-daemon -s / killall / openrazer-daemon)",
      "to": "openrazer-daemon"
    },
    {
      "from": "razerui",
      "protocol": "Unix domain socket IPC (child process spawned via subprocess)",
      "to": "macro-engine"
    },
    {
      "from": "macro-engine",
      "protocol": "Unix domain socket ($XDG_RUNTIME_DIR/hueberry/gui.sock, GUI single-instance socket; newline-terminated allow-listed action names, e.g. toggle-sysmon)",
      "to": "razerui"
    },
    {
      "from": "razerui",
      "protocol": "Subprocess (spawns/stops waybar child in its own process group; pid file $XDG_RUNTIME_DIR/hueberry/sysmon.pid; writes Waybar config + sysmon.json)",
      "to": "sysmon-overlay"
    }
  ],
  "definitions": [],
